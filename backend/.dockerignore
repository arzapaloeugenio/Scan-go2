.env.*
**/.env
**/.env.*

# Logs y temporales.
*.log
logs
**/logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Metadatos del repositorio y del editor.
.git
.gitignore
.vscode
.idea
*.swp
*.swo
*~

# Archivos que no forman parte del runtime.
Dockerfile
.dockerignore
README.md
