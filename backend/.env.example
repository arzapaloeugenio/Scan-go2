NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=Password
DB_NAME=tottus_scan_go

# --- Etapa 3A: PostgreSQL en la nube (Neon / Render) ---
# Si DATABASE_URL tiene valor, se usa esa cadena con SSL y se ignoran las DB_*.
# Vacio = modo local (DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME).
DATABASE_URL=

# --- Etapa 2: autenticacion con Google ---
# Client ID publico de Google OAuth (NO es un secreto). Vacio = ruta deshabilitada.
GOOGLE_CLIENT_ID=

# --- Etapa 2: CORS ---
# Origenes permitidos (separados por coma). No se usa "*".
FRONTEND_URL=
FRONTEND_URL_LOCAL=http://localhost:8000
